{
  "name": "tabmate",
  "description": "一个为个人使用而设计、易于扩展的浏览器插件",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run && node --test \"scripts/ci/*.test.mjs\"",
    "test:e2e": "wxt build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
